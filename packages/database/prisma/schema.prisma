generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id             String                   @id @default(cuid())
  name           String
  slug           String                   @unique
  status         OrganizationStatus       @default(ACTIVE)
  contactEmail   String?
  contactPhone   String?
  website        String?
  logoFileId     String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  auditLogs      AuditLog[]
  conferences    Conference[]
  emailTemplates EmailTemplate[]
  exportJobs     ExportJob[]
  files          File[]
  importJobs     ImportJob[]
  notifications  Notification[]
  memberships    OrganizationMembership[]
  reviewers      Reviewer[]
  roles          Role[]

  @@map("organizations")
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  firstName          String
  lastName           String
  status             UserStatus               @default(INVITED)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  isSuperAdmin       Boolean                  @default(false)
  emailVerifications EmailVerificationToken[]
  memberships        OrganizationMembership[]
  passwordResets     PasswordResetToken[]
  registrations      Registration[]
  sessions           Session[]
  conferenceFeedbacks ConferenceFeedback[]

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  status         MembershipStatus @default(INVITED)
  invitedAt      DateTime         @default(now())
  joinedAt       DateTime?
  roles          MembershipRole[]
  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Role {
  id             String           @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  memberships    MembershipRole[]
  permissions    RolePermission[]
  organization   Organization?    @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id     String           @id @default(cuid())
  module String
  action String
  roles  RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String
  roleId       String
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id])
  role         Role                   @relation(fields: [roleId], references: [id])

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@map("email_verification_tokens")
}

model Conference {
  id                     String                 @id @default(cuid())
  organizationId         String
  name                   String
  slug                   String
  shortName              String?
  description            String?
  startDate              DateTime
  endDate                DateTime
  timezone               String
  venueName              String?
  venueAddress           String?
  city                   String?
  country                String?
  website                String?
  contactEmail           String?
  logoFileId             String?
  bannerFileId           String?
  status                 ConferenceStatus       @default(DRAFT)
  scheduleVersion        Int                    @default(0)
  createdBy              String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  abstracts              Abstract[]
  attendances            Attendance[]
  certificates           Certificate[]
  feedbacks              ConferenceFeedback[]
  checkins               Checkin[]
  formFields             ConferenceFormField[]
  settings               ConferenceSetting?
  tracks                 ConferenceTrack[]
  organization           Organization           @relation(fields: [organizationId], references: [id])
  exhibitors             Exhibitor[]
  orders                 Order[]
  sessions               ProgramSession[]
  registrationCategories RegistrationCategory[]
  registrations          Registration[]
  speakers               Speaker[]
  sponsors               Sponsor[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("conferences")
}

model ConferenceSetting {
  id                             String      @id @default(cuid())
  conferenceId                   String      @unique
  abstractEnabled                Boolean     @default(false)
  abstractStartDate              DateTime?
  abstractEndDate                DateTime?
  reviewEnabled                  Boolean     @default(false)
  reviewMode                     ReviewMode  @default(SINGLE_BLIND)
  registrationEnabled            Boolean     @default(false)
  registrationStartDate          DateTime?
  registrationEndDate            DateTime?
  paymentEnabled                 Boolean     @default(false)
  paymentMode                    PaymentMode @default(MANUAL)
  manualPaymentInstructions      String?
  certificateEnabled             Boolean     @default(false)
  checkinEnabled                 Boolean     @default(false)
  preventSpeakerOverlap          Boolean     @default(false)
  certificateAttendanceThreshold Int         @default(1)
  certificateReviewThreshold     Int         @default(1)
  certificateShowFullName        Boolean     @default(true)
  certificateTemplateFileId          String?   @map("certificatetemplatefileid")
  certificateTemplateMimeType        String?   @map("certificatetemplatemimetype")
  certificateTemplateFieldPositions  Json?     @map("certificatetemplatefieldpositions")
  certificateTemplateUpdatedAt       DateTime? @map("certificatetemplateupdatedat")
  createdAt                      DateTime    @default(now())
  updatedAt                      DateTime    @updatedAt
  conference                     Conference  @relation(fields: [conferenceId], references: [id])

  @@map("conference_settings")
}

model ConferenceTrack {
  id           String           @id @default(cuid())
  conferenceId String
  name         String
  code         String?
  description  String?
  sortOrder    Int              @default(0)
  status       String           @default("ACTIVE")
  abstracts    Abstract[]
  conference   Conference       @relation(fields: [conferenceId], references: [id])
  sessions     ProgramSession[]

  @@index([conferenceId])
  @@map("conference_tracks")
}

model File {
  id             String        @id @default(cuid())
  organizationId String?
  fileName       String
  storageKey     String
  mimeType       String
  size           Int
  bucket         String
  uploadedBy     String
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("files")
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  conferenceId   String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([conferenceId, createdAt])
  @@map("audit_logs")
}

model ConferenceFormField {
  id             String        @id @default(cuid())
  conferenceId   String
  section        String
  fieldKey       String
  label          String
  fieldType      FormFieldType
  isRequired     Boolean       @default(false)
  optionsJson    Json?
  validationJson Json?
  sortOrder      Int           @default(0)
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  conference     Conference    @relation(fields: [conferenceId], references: [id])

  @@unique([conferenceId, fieldKey])
  @@index([conferenceId, status])
  @@map("conference_form_fields")
}

model Abstract {
  id                      String                    @id @default(cuid())
  conferenceId            String
  trackId                 String?
  submissionNumber        String?
  title                   String
  submissionType          String
  presentationPreference  String?
  status                  AbstractStatus            @default(DRAFT)
  submittedBy             String
  currentVersionId        String?
  submittedAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  authors                 AbstractAuthor[]
  decisions               AbstractDecision[]
  revisionRequests        AbstractRevisionRequest[]
  versions                AbstractVersion[]
  conference              Conference                @relation(fields: [conferenceId], references: [id])
  track                   ConferenceTrack?          @relation(fields: [trackId], references: [id])
  presentationAssignments PresentationAssignment[]
  reviewAssignments       ReviewAssignment[]

  @@unique([conferenceId, submissionNumber])
  @@index([conferenceId, status])
  @@index([conferenceId, trackId])
  @@map("abstracts")
}

model AbstractVersion {
  id            String   @id @default(cuid())
  abstractId    String
  versionNumber Int
  formData      Json
  submittedAt   DateTime @default(now())
  submittedBy   String
  abstract      Abstract @relation(fields: [abstractId], references: [id])

  @@unique([abstractId, versionNumber])
  @@map("abstract_versions")
}

model Author {
  id          String           @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  mobile      String?
  designation String?
  institution String?
  department  String?
  city        String?
  country     String?
  createdAt   DateTime         @default(now())
  abstracts   AbstractAuthor[]

  @@map("authors")
}

model AbstractAuthor {
  id              String   @id @default(cuid())
  abstractId      String
  authorId        String
  authorOrder     Int
  isCorresponding Boolean  @default(false)
  isPresenting    Boolean  @default(false)
  abstract        Abstract @relation(fields: [abstractId], references: [id])
  author          Author   @relation(fields: [authorId], references: [id])

  @@unique([abstractId, authorId])
  @@index([abstractId])
  @@map("abstract_authors")
}

model Reviewer {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  status         String             @default("ACTIVE")
  createdAt      DateTime           @default(now())
  assignments    ReviewAssignment[]
  profile        ReviewerProfile?
  organization   Organization       @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, userId])
  @@map("reviewers")
}

model ReviewerProfile {
  id          String   @id @default(cuid())
  reviewerId  String   @unique
  institution String?
  designation String?
  bio         String?
  expertise   String[]
  keywords    String[]
  reviewer    Reviewer @relation(fields: [reviewerId], references: [id])

  @@map("reviewer_profiles")
}

model ReviewAssignment {
  id                 String                 @id @default(cuid())
  conferenceId       String
  abstractId         String
  reviewerId         String
  assignedAt         DateTime               @default(now())
  dueDate            DateTime?
  status             ReviewAssignmentStatus @default(PENDING)
  conflictOfInterest Boolean                @default(false)
  reassignedFromId   String?
  abstract           Abstract               @relation(fields: [abstractId], references: [id])
  reviewer           Reviewer               @relation(fields: [reviewerId], references: [id])
  review             Review?

  @@index([reviewerId, status])
  @@index([abstractId])
  @@map("review_assignments")
}

model Review {
  id                String               @id @default(cuid())
  assignmentId      String               @unique
  overallScore      Int
  originalityScore  Int
  methodologyScore  Int
  significanceScore Int
  presentationScore Int
  commentsToAuthor  String?
  privateComments   String?
  recommendation    ReviewRecommendation
  submittedAt       DateTime             @default(now())
  assignment        ReviewAssignment     @relation(fields: [assignmentId], references: [id])

  @@map("reviews")
}

model AbstractDecision {
  id                 String               @id @default(cuid())
  abstractId         String
  decision           AbstractDecisionType
  reason             String?
  decidedBy          String
  effectiveVersionId String?
  decidedAt          DateTime             @default(now())
  abstract           Abstract             @relation(fields: [abstractId], references: [id])

  @@index([abstractId])
  @@map("abstract_decisions")
}

model AbstractRevisionRequest {
  id          String    @id @default(cuid())
  abstractId  String
  requestedBy String
  reason      String
  dueDate     DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  abstract    Abstract  @relation(fields: [abstractId], references: [id])

  @@index([abstractId])
  @@map("abstract_revision_requests")
}

model RegistrationCategory {
  id           String             @id @default(cuid())
  conferenceId String
  name         String
  description  String?
  conference   Conference         @relation(fields: [conferenceId], references: [id])
  types        RegistrationType[]

  @@index([conferenceId])
  @@map("registration_categories")
}

model RegistrationType {
  id            String               @id @default(cuid())
  categoryId    String
  name          String
  price         Decimal              @db.Decimal(10, 2)
  currency      String
  startDate     DateTime
  endDate       DateTime
  capacity      Int?
  category      RegistrationCategory @relation(fields: [categoryId], references: [id])
  registrations Registration[]

  @@index([categoryId, startDate, endDate])
  @@map("registration_types")
}

model Registration {
  id                 String             @id @default(cuid())
  conferenceId       String
  registrationNumber String             @unique
  userId             String
  registrationTypeId String
  status             RegistrationStatus @default(PENDING)
  totalAmount        Decimal            @db.Decimal(10, 2)
  currency           String
  qrCode             String?            @unique
  registeredAt       DateTime           @default(now())
  attendances        Attendance[]
  certificates       Certificate[]
  checkins           Checkin[]
  order              Order?
  conference         Conference         @relation(fields: [conferenceId], references: [id])
  registrationType   RegistrationType   @relation(fields: [registrationTypeId], references: [id])
  user               User               @relation(fields: [userId], references: [id])

  @@index([conferenceId, status])
  @@index([registrationTypeId])
  @@map("registrations")
}

model Order {
  id             String       @id @default(cuid())
  conferenceId   String
  registrationId String       @unique
  orderNumber    String       @unique
  subtotal       Decimal      @db.Decimal(10, 2)
  discount       Decimal      @default(0) @db.Decimal(10, 2)
  tax            Decimal      @default(0) @db.Decimal(10, 2)
  total          Decimal      @db.Decimal(10, 2)
  currency       String
  status         OrderStatus  @default(PENDING)
  invoice        Invoice?
  items          OrderItem[]
  conference     Conference   @relation(fields: [conferenceId], references: [id])
  registration   Registration @relation(fields: [registrationId], references: [id])
  payments       Payment[]

  @@index([conferenceId, status])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  itemType    String
  referenceId String?
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)
  order       Order   @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  providerOrderId   String?
  providerPaymentId String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  currency          String
  status            PaymentStatus @default(INITIATED)
  reference         String?
  proofFileId       String?
  decidedBy         String?
  rejectionReason   String?
  paidAt            DateTime?
  order             Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  payloadHash String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique
  orderId        String   @unique
  subtotal       Decimal  @db.Decimal(10, 2)
  discount       Decimal  @db.Decimal(10, 2)
  tax            Decimal  @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  documentFileId String?
  issuedAt       DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id])

  @@map("invoices")
}

model ProgramSession {
  id            String                   @id @default(cuid())
  conferenceId  String
  trackId       String?
  title         String
  description   String?
  room          String?
  sessionDate   DateTime
  startTime     DateTime
  endTime       DateTime
  sessionType   String?
  chairId       String?
  coChairId     String?
  status        String                   @default("DRAFT")
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  attendances   Attendance[]
  presentations PresentationAssignment[]
  conference    Conference               @relation(fields: [conferenceId], references: [id])
  track         ConferenceTrack?         @relation(fields: [trackId], references: [id])
  speakers      SessionSpeaker[]

  @@index([conferenceId, sessionDate])
  @@map("program_sessions")
}

model Speaker {
  id            String                   @id @default(cuid())
  conferenceId  String
  userId        String?
  name          String
  designation   String?
  institution   String?
  bio           String?
  photoFileId   String?
  country       String?
  sessions      SessionSpeaker[]
  presentations PresentationAssignment[]
  conference    Conference               @relation(fields: [conferenceId], references: [id])

  @@index([conferenceId])
  @@map("speakers")
}

model SessionSpeaker {
  sessionId String
  speakerId String
  role      String
  session   ProgramSession @relation(fields: [sessionId], references: [id])
  speaker   Speaker        @relation(fields: [speakerId], references: [id])

  @@id([sessionId, speakerId, role])
  @@map("session_speakers")
}

model PresentationAssignment {
  id                 String   @id @default(cuid())
  sessionId          String
  abstractId         String?
  speakerId          String?
  title              String?
  speakerName        String?
  speakerAffiliation String?
  presentationType   String?
  startTime          DateTime
  endTime            DateTime
  sortOrder          Int      @default(0)

  abstract Abstract?      @relation(fields: [abstractId], references: [id])
  session  ProgramSession @relation(fields: [sessionId], references: [id])
  speaker  Speaker?       @relation(fields: [speakerId], references: [id])

  @@unique([sessionId, abstractId])
  @@index([abstractId])
  @@index([speakerId])
  @@map("presentation_assignments")
}

model Checkin {
  id             String       @id @default(cuid())
  conferenceId   String
  registrationId String
  checkinType    String
  checkedInAt    DateTime     @default(now())
  deviceId       String?
  conference     Conference   @relation(fields: [conferenceId], references: [id])
  registration   Registration @relation(fields: [registrationId], references: [id])

  @@index([registrationId])
  @@index([conferenceId, checkinType])
  @@map("checkins")
}

model Attendance {
  id             String          @id @default(cuid())
  conferenceId   String
  registrationId String
  sessionId      String?
  checkedInAt    DateTime        @default(now())
  conference     Conference      @relation(fields: [conferenceId], references: [id])
  registration   Registration    @relation(fields: [registrationId], references: [id])
  session        ProgramSession? @relation(fields: [sessionId], references: [id])

  @@index([registrationId])
  @@index([sessionId])
  @@map("attendances")
}

model Certificate {
  id                String            @id @default(cuid())
  conferenceId      String
  registrationId    String
  certificateType   String
  certificateNumber String            @unique
  fileId            String?
  verificationCode  String            @unique
  issuedAt          DateTime?
  status            CertificateStatus @default(ELIGIBLE)
  createdAt         DateTime          @default(now())
  conference        Conference        @relation(fields: [conferenceId], references: [id])
  registration      Registration      @relation(fields: [registrationId], references: [id])

  @@unique([registrationId, certificateType])
  @@index([conferenceId, status])
  @@map("certificates")
}

model Sponsor {
  id            String     @id @default(cuid())
  conferenceId  String
  name          String
  tier          String
  contactName   String?
  contactEmail  String?
  paymentStatus String     @default("PENDING")
  logoFileId    String?
  website       String?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  conference    Conference @relation(fields: [conferenceId], references: [id])

  @@index([conferenceId])
  @@map("sponsors")
}

model Exhibitor {
  id            String           @id @default(cuid())
  conferenceId  String
  companyName   String
  boothNumber   String?
  contactPerson String?
  paymentStatus String           @default("PENDING")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  staff         ExhibitorStaff[]
  conference    Conference       @relation(fields: [conferenceId], references: [id])

  @@index([conferenceId])
  @@map("exhibitors")
}

model ExhibitorStaff {
  id          String    @id @default(cuid())
  exhibitorId String
  name        String
  email       String?
  exhibitor   Exhibitor @relation(fields: [exhibitorId], references: [id])

  @@index([exhibitorId])
  @@map("exhibitor_staff")
}

model EmailTemplate {
  id             String       @id @default(cuid())
  organizationId String
  conferenceId   String?
  event          String
  subject        String
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, conferenceId, event])
  @@map("email_templates")
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  message        String
  data           Json?
  entityType     String?
  entityId       String?
  readAt         DateTime?
  clearedAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

model ExportJob {
  id             String       @id @default(cuid())
  organizationId String
  conferenceId   String?
  requestedBy    String
  type           String
  status         String       @default("QUEUED")
  resultFileId   String?
  error          String?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("export_jobs")
}

model ImportJob {
  id                String       @id @default(cuid())
  organizationId    String
  conferenceId      String?
  requestedBy       String
  type              String
  status            String       @default("QUEUED")
  sourceFileId      String
  errorReportFileId String?
  rowsProcessed     Int          @default(0)
  rowsFailed        Int          @default(0)
  createdAt         DateTime     @default(now())
  completedAt       DateTime?
  organization      Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("import_jobs")
}


model ConferenceFeedback {
  id             String   @id @default(cuid())
  conferenceId   String
  userId         String
  rating         Int
  contentRating  String
  comments       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conferenceId, userId])
  @@index([userId])
  @@map("conference_feedback")
}


enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum ConferenceStatus {
  DRAFT
  OPEN
  REVIEW
  REGISTRATION
  ONGOING
  COMPLETED
  ARCHIVED
}

enum ReviewMode {
  SINGLE_BLIND
  DOUBLE_BLIND
  OPEN
}

/// *
///  * GATEWAY: online payments through a configured provider (Razorpay/Stripe),
///  * confirmed only by a verified webhook. MANUAL: no gateway is configured
///  * for this conference — staff confirm payment received offline (bank
///  * transfer/cash/cheque) through an audited approval action instead.
enum PaymentMode {
  GATEWAY
  MANUAL
}

enum FormFieldType {
  TEXT
  LONG_TEXT
  RICH_TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  RADIO
  CHECKBOX
  FILE
  URL
  AUTHOR_BLOCK
}


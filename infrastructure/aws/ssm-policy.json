{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOperantEventSecrets",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath",
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/operant-event/prod/*"
    }
  ]
}

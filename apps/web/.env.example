# Server-only — never exposed to the browser (no NEXT_PUBLIC_ prefix).
# Route Handlers and Server Components are the only code that reads this.
BACKEND_API_URL=http://localhost:3001/api/v1

# Optional: set in production if web and api share a parent domain and
# cookies need to be shared across subdomains.
# COOKIE_DOMAIN=.example.com

NODE_ENV=development

DATABASE_URL="postgresql://operant:operant_password@localhost:5432/operant_event?schema=public"
PORT=3001
REDIS_URL="redis://localhost:6379"

# Dev-only placeholders — generate real, distinct secrets per environment,
# e.g. `openssl rand -base64 48`. Never reuse these values outside local dev.
JWT_ACCESS_SECRET="dev-access-secret-change-me-0123456789abcdef"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-0123456789abcdef"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
BCRYPT_SALT_ROUNDS=12

# Optional — only needed by conferences whose ConferenceSetting.paymentMode
# is GATEWAY. Leave unset for MANUAL-only deployments (see docs/plans/04-registration-payments.md).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

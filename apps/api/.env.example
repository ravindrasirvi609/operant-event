DATABASE_URL="postgresql://operant:operant_password@localhost:5432/operant_event?schema=public"
PORT=3001
REDIS_URL="redis://localhost:6379"

# Dev-only placeholders — generate real, distinct secrets per environment,
# e.g. `openssl rand -base64 48`. Never reuse these values outside local dev.
JWT_ACCESS_SECRET="dev-access-secret-change-me-0123456789abcdef"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-0123456789abcdef"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
BCRYPT_SALT_ROUNDS=12

# Optional — only needed by conferences whose ConferenceSetting.paymentMode
# is GATEWAY. Leave unset for MANUAL-only deployments (see docs/plans/04-registration-payments.md).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Shared with apps/worker — both processes must resolve the same absolute
# directory, since a file written by one is read back by the other.
UPLOADS_DIR="./uploads"

# Optional — when set, AuthService sends real verification/password-reset
# emails via Resend instead of logging them to the console (dev fallback).
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=

# Base URL of apps/web, used to build the links in auth emails.
FRONTEND_URL="http://localhost:3000"

DATABASE_URL="postgresql://operant:operant_password@localhost:5432/operant_event?schema=public"
REDIS_URL="redis://localhost:6379"

# Required by the shared @operant-event/config schema even though the worker
# doesn't verify tokens itself yet — keep in sync with apps/api's secrets.
JWT_ACCESS_SECRET="dev-access-secret-change-me-0123456789abcdef"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-0123456789abcdef"

# Shared with apps/api — both processes must resolve the same absolute
# directory, since a file written by one is read back by the other.
UPLOADS_DIR="./uploads"

# Required for real email sending — get a key at https://resend.com.
# Without it, the email processor logs and skips sending (see email.processor.ts).
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM_ADDRESS="noreply@example.com"
